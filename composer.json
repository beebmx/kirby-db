{
    "name": "beebmx/kirby-db",
    "description": "Enable database support for Illuminate\\Database in Kirby",
    "keywords": [
        "database",
        "model",
        "eloquent",
        "kirby",
        "kirby-plugin",
        "kirby3",
        "kirby4",
        "kirby5",
        "kirby6"
    ],
    "version": "5.0.1",
    "type": "kirby-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Fernando Gutierrez",
            "homepage": "https://beeb.mx"
        }
    ],
    "require": {
        "php": "^8.4",
        "getkirby/composer-installer": "^1.2",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/events": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/pagination": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "getkirby/cms": "^4.0|^5.0|^6.0",
        "illuminate/hashing": "^10.0|^11.0|^12.0|^13.0",
        "laravel/pint": "^1.0",
        "pestphp/pest": "^5.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "getkirby/composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "autoload": {
        "psr-4": {
            "Beebmx\\KirbyDb\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test-setup": [
            "php tests/helpers.php",
            "vendor/bin/pest"
        ],
        "test": "@php -d auto_prepend_file=tests/constants.php vendor/bin/pest"
    },
    "extra": {
        "kirby-cms-path": false,
        "kirby-plugin-path": "tests/Fixtures/site/plugins",
        "kirby": {
            "compatible": "^4.0 || ^5.0 || ^6.0"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
